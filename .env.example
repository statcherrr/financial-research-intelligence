# FRIS Environment Configuration
# Copy this file to .env and fill in the values needed for your setup.
# Never commit the real .env file to version control.

# === LLM Provider ===
# Available values: mock, anthropic, openai
LLM_PROVIDER=mod

# === API Keys ===
# Only set these when LLM_PROVIDER matches the provider.
# Never commit real keys.

# === SEC EDGAR ===
# SEC requires a User-Agent header identifying your application and contact.
# Use a descriptive name and a real email address you own.
# Example (replace with your own):
SEC_USER_AGENT=FRIS Research research@example.com
